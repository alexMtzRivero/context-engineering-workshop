OPENROUTER_API_KEY=
MODEL=openrouter:anthropic/claude-haiku-5.5

# Haiku 5.5 es barato y se equivoca con la conversación muy larga; para comparar, usa
# openrouter:anthropic/claude-sonnet-5.5.

# Para usar Anthropic directamente, cambia MODEL y completa esta key.
# MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=
